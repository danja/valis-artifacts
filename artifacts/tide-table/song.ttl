# song.ttl
#
# "Tide Table": the layout and the mix as data. The notes are in midi/, played by the circuits in circuits/.

@prefix val:  <http://purl.org/stuff/valis/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix :     <urn:valis-artifacts:tide-table#> .

:song a val:Song ;
    val:title "Tide Table" ;
    val:tempo 78 ;
    val:loudness -14 ;
    val:fadeSeconds 8 ;
    val:roomAmount 0.2 ;
    val:roomDecay 0.5 ;
    val:roomLowpass 6000 ;
    val:drive 1.2 ;
    val:hasSection :intro , :tide , :rise , :memory , :flood , :ebb ;
    val:hasPart :heart , :sub , :shakers , :cello , :harp , :bell , :epiano , :strings , :choir , :ghost ;
    val:hasReturn :harphall , :cellohall .

:intro a val:Section ; val:index 1 ; val:bars 8 ; val:level -1.0 .
:tide a val:Section ; val:index 2 ; val:bars 16 ; val:level 0.0 .
:rise a val:Section ; val:index 3 ; val:bars 16 ; val:level 1.5 .
:memory a val:Section ; val:index 4 ; val:bars 8 ; val:level -2.5 .
:flood a val:Section ; val:index 5 ; val:bars 16 ; val:level 2.5 .
:ebb a val:Section ; val:index 6 ; val:bars 8 ; val:level 0.0 .

:heart a val:Part ; val:index 1 ; val:circuit "circuits/heart.ttl" ; val:level -22 ; val:pan 0.0 ; val:highpass 0 .
:sub a val:Part ; val:index 2 ; val:circuit "circuits/sub.ttl" ; val:level -23 ; val:pan 0.0 ; val:highpass 0 .
:shakers a val:Part ; val:index 3 ; val:circuit "circuits/shakers.ttl" ; val:level -31 ; val:pan 0.3 ; val:highpass 300 .
:cello a val:Part ; val:index 4 ; val:circuit "circuits/cello.ttl" ; val:level -22 ; val:pan -0.1 ; val:highpass 60 .
:harp a val:Part ; val:index 5 ; val:circuit "circuits/harp.ttl" ; val:level -24 ; val:pan 0.2 ; val:highpass 100 .
:bell a val:Part ; val:index 6 ; val:circuit "circuits/bell.ttl" ; val:level -29 ; val:pan 0.35 ; val:highpass 300 .
:epiano a val:Part ; val:index 7 ; val:circuit "circuits/epiano.ttl" ; val:level -28 ; val:pan -0.3 ; val:highpass 150 .
:strings a val:Part ; val:index 8 ; val:circuit "circuits/strings.ttl" ; val:level -30 ; val:pan 0.0 ; val:highpass 150 .
:choir a val:Part ; val:index 9 ; val:circuit "circuits/choir.ttl" ; val:level -31 ; val:pan 0.0 ; val:highpass 200 .
:ghost a val:Part ; val:index 10 ; val:circuit "circuits/ghost.ttl" ; val:level -29 ; val:pan -0.2 ; val:highpass 120 .

:harphall a val:Return ; val:index 1 ; val:source :harp ; val:circuit "circuits/reverb-return.ttl" ; val:level -30 ; val:pan 0.4 .
:cellohall a val:Return ; val:index 2 ; val:source :cello ; val:circuit "circuits/reverb-return.ttl" ; val:level -31 ; val:pan -0.4 .
