:Am a val:Chord ; val:root 33 ; val:pickup 40 ; val:tones "57 60 64" .
:F a val:Chord ; val:root 29 ; val:pickup 36 ; val:tones "53 57 60" .
:Dm a val:Chord ; val:root 38 ; val:pickup 45 ; val:tones "50 53 57" .
:E a val:Chord ; val:root 28 ; val:pickup 35 ; val:tones "52 59 64" .
:G a val:Chord ; val:root 31 ; val:pickup 38 ; val:tones "55 59 62" .

:backbeat a val:Pattern ; val:bars 1 ; val:hasLane
    [ val:key 38 ; val:steps "....|X...|....|X..." ; val:velocity 100 ; val:accent 16 ] .
:bass_baa a val:Pattern ; val:bars 8 ; val:hasLane
    [ val:key 69 ; val:steps "x...x..........................................................................................................................." ; val:velocity 104 ; val:length 4 ; val:gate 0.88 ; val:transpose -36 ] ,
    [ val:key 69 ; val:steps "........................................................x......................................................................." ; val:velocity 104 ; val:length 8 ; val:gate 0.88 ; val:transpose -36 ] ,
    [ val:key 71 ; val:steps "................................................x...x..........................................................................." ; val:velocity 104 ; val:length 4 ; val:gate 0.88 ; val:transpose -36 ] ,
    [ val:key 71 ; val:steps "........................................................................................x...............................x......." ; val:velocity 104 ; val:length 8 ; val:gate 0.88 ; val:transpose -36 ] ,
    [ val:key 72 ; val:steps "........................................x...x...................................x...x...........................x...x..........." ; val:velocity 104 ; val:length 4 ; val:gate 0.88 ; val:transpose -36 ] ,
    [ val:key 74 ; val:steps "................................x...x...................................x...x...........................x...x..................." ; val:velocity 104 ; val:length 4 ; val:gate 0.88 ; val:transpose -36 ] ,
    [ val:key 76 ; val:steps "........x...x...................................................x...x...........................x...x..........................." ; val:velocity 104 ; val:length 4 ; val:gate 0.88 ; val:transpose -36 ] ,
    [ val:key 76 ; val:steps "........................x......................................................................................................." ; val:velocity 104 ; val:length 8 ; val:gate 0.88 ; val:transpose -36 ] ,
    [ val:key 77 ; val:steps "................x...x..........................................................................................................." ; val:velocity 104 ; val:length 4 ; val:gate 0.88 ; val:transpose -36 ] .
:bass_off a val:Pattern ; val:bars 1 ; val:hasLane
    [ val:voice "root" ; val:steps "..x.|..x.|..x.|..x." ; val:velocity 100 ; val:length 2 ; val:gate 0.9 ] .
:climb a val:Pattern ; val:bars 1 ; val:hasLane
    [ val:voice "low" ; val:steps "x..............." ; val:velocity 96 ; val:length 2 ; val:gate 0.8 ] ,
    [ val:voice "root" ; val:steps "....x.......x..." ; val:velocity 96 ; val:length 2 ; val:gate 0.8 ; val:octave 3 ] ,
    [ val:voice "root" ; val:steps "........x......." ; val:velocity 96 ; val:length 2 ; val:gate 0.8 ; val:octave 4 ] ,
    [ val:voice "top" ; val:steps "..x...........x." ; val:velocity 96 ; val:length 2 ; val:gate 0.8 ] ,
    [ val:voice "top" ; val:steps "......x...x....." ; val:velocity 96 ; val:length 2 ; val:gate 0.8 ; val:octave 1 ] .
:hat_closed a val:Pattern ; val:bars 1 ; val:hasLane
    [ val:key 42 ; val:steps "xxxx|xxxx|xxxx|xxxx" ; val:velocity 20 ] .
:hat_full a val:Pattern ; val:bars 1 ; val:hasLane
