# song.ttl
#
# "All Fall Down": the layout and the mix as data. Generated by scripts/all-fall-down/make.py;
# the notes are in score.ttl, played by the circuits in circuits/.

@prefix val:  <http://purl.org/stuff/valis/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix :     <urn:valis-artifacts:all-fall-down#> .

:song a val:Song ;
    val:title "All Fall Down" ;
    val:tempo 140 ;
    val:score "score.ttl" ;
    val:loudness -10 ;
    val:fadeSeconds 8 ;
    val:roomAmount 0.07 ;
    val:roomDecay 0.35 ;
    val:drive 1.4 ;
    val:hasSection :intro , :build1 , :drop1 , :break , :build2 , :drop2 , :outro ;
    val:hasPart :kick , :snare , :hat , :bass , :lead , :arp , :pad , :riser , :voice ;
    val:hasReturn :lead-verb .

:intro a val:Section ; val:index 1 ; val:bars 16 ; val:level 1.5 .
:build1 a val:Section ; val:index 2 ; val:bars 8 ; val:level 1 .
:drop1 a val:Section ; val:index 3 ; val:bars 16 ; val:level 1 .
:break a val:Section ; val:index 4 ; val:bars 16 ; val:level 2 .
:build2 a val:Section ; val:index 5 ; val:bars 8 ; val:level 1 .
:drop2 a val:Section ; val:index 6 ; val:bars 24 ; val:level 2.5 .
:outro a val:Section ; val:index 7 ; val:bars 16 ; val:level 1.5 .

:kick a val:Part ; val:index 1 ; val:circuit "circuits/nursery-humpty-kick.ttl" ; val:level -17 ; val:pan 0 ; val:highpass 30 .
:snare a val:Part ; val:index 2 ; val:circuit "circuits/nursery-rattle-snare.ttl" ; val:level -22 ; val:pan 0 ; val:highpass 120 .
:hat a val:Part ; val:index 3 ; val:circuit "circuits/nursery-ding-dong-hat.ttl" ; val:level -30 ; val:pan 0.1 ; val:highpass 400 .
:bass a val:Part ; val:index 4 ; val:circuit "circuits/nursery-black-sheep-bass.ttl" ; val:level -22 ; val:pan 0 ; val:highpass 35 .
:lead a val:Part ; val:index 5 ; val:circuit "circuits/nursery-twinkle-lead.ttl" ; val:level -21 ; val:pan 0.1 ; val:highpass 200 .
:arp a val:Part ; val:index 6 ; val:circuit "circuits/nursery-incy-wincy-arp.ttl" ; val:level -27 ; val:pan -0.25 ; val:highpass 150 .
:pad a val:Part ; val:index 7 ; val:circuit "circuits/nursery-rock-a-bye-pad.ttl" ; val:level -27 ; val:pan 0 ; val:highpass 70 .
:riser a val:Part ; val:index 8 ; val:circuit "circuits/nursery-wind-up-riser.ttl" ; val:level -31 ; val:pan 0 ; val:highpass 200 .
:voice a val:Part ; val:index 9 ; val:recorded true ; val:level -22 ; val:pan 0 ; val:highpass 150 .

:lead-verb a val:Return ; val:index 1 ; val:source :lead ; val:circuit "circuits/reverb-return.ttl" ;
    val:level -35 ; val:pan -0.2 ; val:highpass 250 .
