:kick_fill a val:Pattern ; val:bars 1 ; val:hasLane
    [ val:key 36 ; val:steps "X...|X...|X...|X.X." ; val:velocity 104 ; val:accent 18 ] .
:kick_gap a val:Pattern ; val:bars 1 ; val:hasLane
    [ val:key 36 ; val:steps "X...|X...|X...|...." ; val:velocity 104 ; val:accent 18 ] .
:kick_roll a val:Pattern ; val:bars 1 ; val:hasLane
    [ val:key 36 ; val:steps "X...|X...|XxXx|XxXx" ; val:velocity 100 ; val:accent 24 ] .
:kick4 a val:Pattern ; val:bars 1 ; val:hasLane
    [ val:key 36 ; val:steps "X...|X...|X...|X..." ; val:velocity 104 ; val:accent 18 ] .
:kit_groove a val:Pattern ; val:bars 1 ; val:hasLane
    [ val:key 42 ; val:steps ".x.x|.x.x|.x.x|.x.x" ; val:velocity 72 ] ,
    [ val:key 46 ; val:steps "..x.|..x.|..x.|..x." ; val:velocity 84 ] ,
    [ val:key 39 ; val:steps "....|X...|....|X..." ; val:velocity 92 ; val:accent 16 ] .
:ost_full a val:Pattern ; val:bars 1 ; val:hasLane
    [ val:voice "root" ; val:steps "x...|x...|x...|x..." ; val:velocity 96 ; val:length 1 ; val:gate 0.7 ; val:octave 2 ] ,
    [ val:voice "low" ; val:steps "..x.|..x.|..x.|..x." ; val:velocity 84 ; val:length 1 ; val:gate 0.7 ; val:octave -1 ] ,
    [ val:voice "top" ; val:steps "...x|...x|...x|...x" ; val:velocity 90 ; val:length 1 ; val:gate 0.7 ; val:octave -1 ] .
:ost_gap a val:Pattern ; val:bars 1 ; val:hasLane
    [ val:voice "root" ; val:steps "x...|x...|x...|...." ; val:velocity 96 ; val:length 1 ; val:gate 0.7 ; val:octave 2 ] ,
    [ val:voice "low" ; val:steps "..x.|..x.|..x.|...." ; val:velocity 84 ; val:length 1 ; val:gate 0.7 ; val:octave -1 ] ,
    [ val:voice "top" ; val:steps "...x|...x|...x|...." ; val:velocity 90 ; val:length 1 ; val:gate 0.7 ; val:octave -1 ] .
:ost_sparse a val:Pattern ; val:bars 1 ; val:hasLane
    [ val:voice "root" ; val:steps "x...|x...|x...|x..." ; val:velocity 90 ; val:length 1 ; val:gate 0.7 ; val:octave 2 ] ,
    [ val:voice "low" ; val:steps "....|..x.|....|..x." ; val:velocity 78 ; val:length 1 ; val:gate 0.7 ; val:octave -1 ] .
:riser4 a val:Pattern ; val:bars 4 ; val:hasLane
    [ val:key 60 ; val:steps "x..............................................................." ; val:velocity 100 ; val:length 62 ; val:gate 1 ] .
:roll16 a val:Pattern ; val:bars 1 ; val:hasLane
    [ val:key 38 ; val:steps "xxxx|xxxx|xxxx|xxxx" ; val:velocity 110 ] .
:roll16_gap a val:Pattern ; val:bars 1 ; val:hasLane
    [ val:key 38 ; val:steps "xxxx|xxxx|xxxx|...." ; val:velocity 112 ] .
:roll8 a val:Pattern ; val:bars 1 ; val:hasLane
    [ val:key 38 ; val:steps "x.x.|x.x.|x.x.|x.x." ; val:velocity 88 ] .
:tomfill a val:Pattern ; val:bars 1 ; val:hasLane
    [ val:key 38 ; val:steps "....|....|....|x.x." ; val:velocity 96 ] ,
    [ val:key 50 ; val:steps "....|....|....|..x." ; val:velocity 100 ] ,
    [ val:key 43 ; val:steps "....|....|.x.x|...." ; val:velocity 100 ] ,
    [ val:key 41 ; val:steps "....|....|x.x.|...." ; val:velocity 100 ] .

