:Gm a val:Chord ; val:root 31 ; val:pickup 38 ; val:tones "70 74 79" .
:Eb a val:Chord ; val:root 27 ; val:pickup 34 ; val:tones "70 75 79" .
:Bb a val:Chord ; val:root 34 ; val:pickup 41 ; val:tones "70 74 77" .
:F a val:Chord ; val:root 29 ; val:pickup 36 ; val:tones "69 72 77" .

:bass_off a val:Pattern ; val:bars 1 ; val:hasLane
    [ val:voice "root" ; val:steps "..x.|..x.|..x.|..x." ; val:velocity 100 ; val:length 2 ; val:gate 0.9 ] .
:bass_roll a val:Pattern ; val:bars 1 ; val:hasLane
    [ val:voice "root" ; val:steps ".xxx|.xxx|.xxx|.xxx" ; val:velocity 100 ; val:length 1 ; val:gate 0.85 ] ,
    [ val:voice "pickup" ; val:steps "....|....|....|...x" ; val:velocity 96 ; val:length 1 ; val:gate 0.85 ] .
:boom a val:Pattern ; val:bars 1 ; val:hasLane
    [ val:key 35 ; val:steps "X...|....|....|...." ; val:velocity 110 ; val:length 14 ; val:gate 1 ] .
:hats a val:Pattern ; val:bars 1 ; val:hasLane
    [ val:key 42 ; val:steps "x.x.|x.x.|x.x.|x.x." ; val:velocity 78 ] .
