# score.ttl
#
# "Street Hammer": generated by scripts/street-hammer/make.py from its table. Play it with
# `valis-song score song.ttl`. The bass, kit, kick, mallet, lead and riser are all here.

@prefix val: <http://purl.org/stuff/valis/> .
@prefix :    <urn:valis-artifacts:street-hammer#> .

:score a val:Score ; val:seed 170 ;
    val:progression "Gm Gm Eb Eb Bb Bb F F" ;
    val:hasChord :Gm , :Eb , :Bb , :F ;
    val:hasPattern :bass_off , :bass_roll , :boom , :hats , :hook , :hook_hi , :kick_fill , :kick_gap , :kick_roll , :kick4 , :kit_groove , :ost_full , :ost_gap , :ost_sparse , :riser4 , :roll16 , :roll16_gap , :roll8 , :tomfill ;
