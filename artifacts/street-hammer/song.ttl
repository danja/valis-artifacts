# song.ttl
#
# "Street Hammer": the layout and the mix as data. Generated by scripts/street-hammer/make.py;
# the notes are in score.ttl, played by the circuits in circuits/.

@prefix val:  <http://purl.org/stuff/valis/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix :     <urn:valis-artifacts:street-hammer#> .

:song a val:Song ;
    val:title "Street Hammer" ;
    val:tempo 170 ;
    val:score "score.ttl" ;
    val:loudness -10 ;
    val:fadeSeconds 6 ;
    val:roomAmount 0.05 ;
    val:roomDecay 0.25 ;
    val:drive 1.6 ;
    val:hasSection :intro , :build1 , :drop1 , :break1 , :build2 , :drop2 , :break2 , :drop3 , :outro ;
    val:hasPart :kick , :kit , :bass , :xylo , :lead , :riser ;
    val:hasReturn :lead-verb .

:intro a val:Section ; val:index 1 ; val:bars 16 ; val:level -4 .
:build1 a val:Section ; val:index 2 ; val:bars 8 ; val:level -1 .
:drop1 a val:Section ; val:index 3 ; val:bars 32 ; val:level 1 .
:break1 a val:Section ; val:index 4 ; val:bars 16 ; val:level -6 .
:build2 a val:Section ; val:index 5 ; val:bars 8 ; val:level -1 .
:drop2 a val:Section ; val:index 6 ; val:bars 32 ; val:level 2.5 .
:break2 a val:Section ; val:index 7 ; val:bars 8 ; val:level -6 .
:drop3 a val:Section ; val:index 8 ; val:bars 16 ; val:level 3 .
:outro a val:Section ; val:index 9 ; val:bars 16 ; val:level -4 .

:kick a val:Part ; val:index 1 ; val:circuit "circuits/gabber-kick.ttl" ; val:level -17 ; val:pan 0 ; val:highpass 30 .
:kit a val:Part ; val:index 2 ; val:circuit "circuits/909.ttl" ; val:level -27 ; val:pan 0 ; val:highpass 120 .
:bass a val:Part ; val:index 3 ; val:circuit "circuits/hc-bass.ttl" ; val:level -23 ; val:pan 0 ; val:highpass 35 .
:xylo a val:Part ; val:index 4 ; val:circuit "circuits/xylo.ttl" ; val:level -28 ; val:pan -0.15 ; val:highpass 150 .
:lead a val:Part ; val:index 5 ; val:circuit "circuits/hoover.ttl" ; val:level -27 ; val:pan 0.15 ; val:highpass 200 .
:riser a val:Part ; val:index 6 ; val:circuit "circuits/riser.ttl" ; val:level -34 ; val:pan 0 ; val:highpass 200 .

:lead-verb a val:Return ; val:index 1 ; val:source :lead ; val:circuit "circuits/reverb-return.ttl" ;
    val:level -36 ; val:pan -0.2 ; val:highpass 250 .
