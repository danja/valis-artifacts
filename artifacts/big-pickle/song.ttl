# song.ttl
#
# "Big Pickle": the layout and the mix as data. Generated by scripts/big-pickle/make.py;
# the notes are in score.ttl, played by the circuits in circuits/.

@prefix val:  <http://purl.org/stuff/valis/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix :     <urn:valis-artifacts:big-pickle#> .

:song a val:Song ;
    val:title "Big Pickle" ;
    val:tempo 138 ;
    val:score "score.ttl" ;
    val:loudness -10 ;
    val:tailSeconds 10 ;
    val:fadeSeconds 6 ;
    val:roomAmount 0.06 ;
    val:roomDecay 0.35 ;
    val:roomLowpass 5000 ;
    val:drive 1.5 ;
    val:hasSection :intro , :build1 , :drop1 , :break1 , :build2 , :drop2 , :break2 , :build3 , :drop3 , :outro ;
    val:hasPart :kick , :kit , :bass , :stab , :pad , :arp , :lead , :riser ;
    val:hasReturn :stab-verb , :pad-verb , :arp-echo .

:intro a val:Section ; val:index 1 ; val:bars 16 ; val:level -5 .
:build1 a val:Section ; val:index 2 ; val:bars 8 ; val:level -2 .
:drop1 a val:Section ; val:index 3 ; val:bars 24 ; val:level 0 .
:break1 a val:Section ; val:index 4 ; val:bars 16 ; val:level -2 .
:build2 a val:Section ; val:index 5 ; val:bars 8 ; val:level -2 .
:drop2 a val:Section ; val:index 6 ; val:bars 24 ; val:level 1 .
:break2 a val:Section ; val:index 7 ; val:bars 8 ; val:level 2 .
:build3 a val:Section ; val:index 8 ; val:bars 8 ; val:level -2 .
:drop3 a val:Section ; val:index 9 ; val:bars 16 ; val:level 2 .
:outro a val:Section ; val:index 10 ; val:bars 12 ; val:level -4 .

:kick a val:Part ; val:index 1 ; val:circuit "circuits/y2k-kick.ttl" ; val:level -14 ; val:pan 0 ; val:highpass 30 .
:kit a val:Part ; val:index 2 ; val:circuit "circuits/909.ttl" ; val:level -24.5 ; val:pan 0 ; val:highpass 130 .
:bass a val:Part ; val:index 3 ; val:circuit "circuits/y2k-bass.ttl" ; val:level -20 ; val:pan 0 ; val:highpass 30 .
:stab a val:Part ; val:index 4 ; val:circuit "circuits/y2k-stab.ttl" ; val:level -22.5 ; val:pan 0.1 ; val:highpass 220 .
:pad a val:Part ; val:index 5 ; val:circuit "circuits/y2k-pad.ttl" ; val:level -28.5 ; val:pan -0.1 ; val:highpass 180 .
:arp a val:Part ; val:index 6 ; val:circuit "circuits/y2k-bleep.ttl" ; val:level -26 ; val:pan 0.25 ; val:highpass 500 .
:lead a val:Part ; val:index 7 ; val:circuit "circuits/y2k-lead.ttl" ; val:level -22 ; val:pan 0.05 ; val:highpass 260 .
:riser a val:Part ; val:index 8 ; val:circuit "circuits/y2k-riser.ttl" ; val:level -28 ; val:pan 0 ; val:highpass 300 .

:stab-verb a val:Return ; val:index 1 ; val:source :stab ; val:circuit "circuits/reverb-return.ttl" ;
    val:level -28.5 ; val:pan 0.55 ; val:highpass 350 .
:pad-verb a val:Return ; val:index 2 ; val:source :pad ; val:circuit "circuits/reverb-return.ttl" ;
    val:level -28.5 ; val:pan -0.55 ; val:highpass 250 .
:arp-echo a val:Return ; val:index 3 ; val:source :arp ; val:circuit "circuits/dub-delay.ttl" ;
    val:level -28 ; val:pan 0.6 ; val:highpass 600 .
