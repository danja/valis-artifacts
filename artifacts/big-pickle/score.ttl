:Am a val:Chord ; val:root 33 ; val:pickup 40 ; val:tones "60 64 69" .
:F a val:Chord ; val:root 29 ; val:pickup 36 ; val:tones "60 65 69" .
:C a val:Chord ; val:root 36 ; val:pickup 43 ; val:tones "60 64 67" .
:G a val:Chord ; val:root 31 ; val:pickup 38 ; val:tones "59 62 67" .
:Dm a val:Chord ; val:root 38 ; val:pickup 45 ; val:tones "62 65 69" .
:E a val:Chord ; val:root 28 ; val:pickup 35 ; val:tones "59 64 68" .

:arp_16 a val:Pattern ; val:bars 1 ; val:hasLane
    [ val:voice "root" ; val:steps "x...|x...|x...|x..." ; val:velocity 92 ; val:length 1 ; val:gate 0.8 ; val:octave 1 ] ,
    [ val:voice "low" ; val:steps ".x..|.x..|.x..|.x.." ; val:velocity 88 ; val:length 1 ; val:gate 0.8 ; val:octave 1 ] ,
    [ val:voice "top" ; val:steps "..x.|..x.|..x.|..x." ; val:velocity 90 ; val:length 1 ; val:gate 0.8 ; val:octave -1 ] ,
    [ val:voice "low" ; val:steps "...x|...x|...x|...x" ; val:velocity 86 ; val:length 1 ; val:gate 0.8 ; val:octave 2 ] .
:arp_slow a val:Pattern ; val:bars 1 ; val:hasLane
    [ val:voice "root" ; val:steps "x...|x...|x...|x..." ; val:velocity 90 ; val:length 2 ; val:gate 0.8 ; val:octave 1 ] ,
    [ val:voice "top" ; val:steps "..x.|..x.|..x.|..x." ; val:velocity 86 ; val:length 2 ; val:gate 0.8 ; val:octave -1 ] .
:bass_break a val:Pattern ; val:bars 1 ; val:hasLane
    [ val:voice "root" ; val:steps "x...|....|....|...." ; val:velocity 96 ; val:length 12 ; val:gate 0.95 ] .
:bass_off a val:Pattern ; val:bars 1 ; val:hasLane
    [ val:voice "root" ; val:steps "..x.|..x.|..x.|..x." ; val:velocity 104 ; val:length 2 ; val:gate 0.9 ] .
:bass_roll a val:Pattern ; val:bars 1 ; val:hasLane
    [ val:voice "root" ; val:steps "..xx|..xx|..xx|..xx" ; val:velocity 102 ; val:length 1 ; val:gate 0.8 ] .
:boom a val:Pattern ; val:bars 1 ; val:hasLane
    [ val:key 35 ; val:steps "X...|....|....|...." ; val:velocity 118 ; val:length 14 ; val:gate 1 ] .
