# score.ttl
#
# "Big Pickle": generated by scripts/big-pickle/make.py from its table. Play it with
# `valis-song score song.ttl`. The kick, 909, bass, stab, pad, bleep arp, lead and riser are all here.

@prefix val: <http://purl.org/stuff/valis/> .
@prefix :    <urn:valis-artifacts:big-pickle#> .

:score a val:Score ; val:seed 2000 ;
    val:progression "Am F C G" ;
    val:hasChord :Am , :F , :C , :G , :Dm , :E ;
    val:hasPattern :arp_16 , :arp_slow , :bass_break , :bass_off , :bass_roll , :boom , :break_hook , :hats , :hats16 , :hook , :hook_hi , :kick_fill , :kick_gap , :kick_roll , :kick4 , :kit_groove , :pad_hold , :rim , :riser4 , :roll16 , :roll16_gap , :roll8 , :stab_hi , :stab_long , :stab_off , :tomfill ;
    val:hasFeel :kick-feel , :kit-feel , :bass-feel , :stab-feel , :arp-feel , :lead-feel ;
    val:hasPlay
