# y2k-lead.ttl
# 
# A wide lead in the year 2000 manner: five saws, four of them slightly detuned and one an octave
# up, into a resonant low-pass opened by an envelope, a chorus and a short portamento. The detune is the width;
# the filter envelope gives each phrase a bright edge.

@prefix val:   <http://purl.org/stuff/valis/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix trn:   <http://purl.org/stuff/transmissions/> .
@prefix :      <urn:valis-artifacts:big-pickle:y2klead#> .

:y2klead a val:Circuit , trn:PluginProfile ;
    trn:role trn:AudioInstrument ;
    trn:accepts trn:Midi ;
    trn:produces trn:Audio ;
    rdfs:label "Y2K lead" ;
    val:element :pitch , :glide , :r2 , :r3 , :r4 , :r5 , :saw1 , :saw2 , :saw3 , :saw4 , :saw5 , :l1 , :l2 , :l3 , :l4 , :l5 , :mix , :filtEnv , :cutoff , :vcf , :ampEnv , :vca , :chorus , :trim , :limit , :out ;
    val:arc :a_pitch_out__glide_in ,
        :a_glide_out__saw1_frequency ,
        :a_glide_out__r2_a ,
        :a_r2_out__saw2_frequency ,
        :a_glide_out__r3_a ,
        :a_r3_out__saw3_frequency ,
        :a_glide_out__r4_a ,
        :a_r4_out__saw4_frequency ,
        :a_glide_out__r5_a ,
        :a_r5_out__saw5_frequency ,
        :a_saw1_out__l1_in ,
        :a_l1_out__mix_in ,
        :a_saw2_out__l2_in ,
        :a_l2_out__mix_in ,
        :a_saw3_out__l3_in ,
        :a_l3_out__mix_in ,
        :a_saw4_out__l4_in ,
        :a_l4_out__mix_in ,
        :a_saw5_out__l5_in ,
        :a_l5_out__mix_in ,
        :a_filtEnv_out__cutoff_in ,
        :a_cutoff_out__vcf_cutoff ,
        :a_mix_out__vcf_in ,
        :a_vcf_out__vca_in ,
        :a_ampEnv_out__vca_cv ,
        :a_vca_out__chorus_in ,
        :a_chorus_out__trim_in ,
        :a_trim_out__limit_in ,
        :a_limit_out__out_in .

:pitch a val:MidiPitch .

:glide a val:Slew ;
    val:rise 8.0 ;
    val:fall 8.0 .

:r2 a val:ControlMultiply ;
    val:b 1.006 .

:r3 a val:ControlMultiply ;
    val:b 0.994 .

:r4 a val:ControlMultiply ;
    val:b 1.012 .

:r5 a val:ControlMultiply ;
    val:b 2.0 .

:saw1 a val:Oscillator ;
    val:shape 1 .

:saw2 a val:Oscillator ;
    val:shape 1 .

:saw3 a val:Oscillator ;
    val:shape 1 .

:saw4 a val:Oscillator ;
    val:shape 1 .

:saw5 a val:Oscillator ;
    val:shape 1 .

:l1 a val:Gain ;
    val:gain -4.0 .

:l2 a val:Gain ;
    val:gain -7.0 .

:l3 a val:Gain ;
    val:gain -7.0 .

:l4 a val:Gain ;
    val:gain -9.0 .

:l5 a val:Gain ;
    val:gain -12.0 .

:mix a val:Mixer .

:filtEnv a val:Envelope ;
    val:attack 4.0 ;
    val:decay 420.0 ;
    val:sustain 0.45 ;
    val:release 220.0 .

:cutoff a val:Scale ;
    val:min 1100.0 ;
    val:max 8500.0 .

:vcf a val:Ladder ;
    val:resonance 0.18 ;
    val:drive 1.3 .

:ampEnv a val:Envelope ;
    val:attack 6.0 ;
    val:decay 320.0 ;
    val:sustain 0.8 ;
    val:release 260.0 .

:vca a val:VCA .

:chorus a val:Chorus ;
    val:rate 0.55 ;
    val:depth 2.5 ;
    val:mix 0.35 .

:trim a val:Gain ;
    val:gain -10.0 .

:limit a val:Limiter ;
    val:ceiling -1.0 .

:out a val:Output .

:a_pitch_out__glide_in a val:ControlArc ;
    val:from [ val:node :pitch ; val:port "out" ] ;
    val:to   [ val:node :glide ; val:port "in" ] .

:a_glide_out__saw1_frequency a val:ControlArc ;
    val:from [ val:node :glide ; val:port "out" ] ;
    val:to   [ val:node :saw1 ; val:port "frequency" ] .

:a_glide_out__r2_a a val:ControlArc ;
    val:from [ val:node :glide ; val:port "out" ] ;
    val:to   [ val:node :r2 ; val:port "a" ] .

:a_r2_out__saw2_frequency a val:ControlArc ;
    val:from [ val:node :r2 ; val:port "out" ] ;
    val:to   [ val:node :saw2 ; val:port "frequency" ] .

:a_glide_out__r3_a a val:ControlArc ;
    val:from [ val:node :glide ; val:port "out" ] ;
    val:to   [ val:node :r3 ; val:port "a" ] .

:a_r3_out__saw3_frequency a val:ControlArc ;
    val:from [ val:node :r3 ; val:port "out" ] ;
    val:to   [ val:node :saw3 ; val:port "frequency" ] .

:a_glide_out__r4_a a val:ControlArc ;
    val:from [ val:node :glide ; val:port "out" ] ;
    val:to   [ val:node :r4 ; val:port "a" ] .

:a_r4_out__saw4_frequency a val:ControlArc ;
    val:from [ val:node :r4 ; val:port "out" ] ;
    val:to   [ val:node :saw4 ; val:port "frequency" ] .

:a_glide_out__r5_a a val:ControlArc ;
    val:from [ val:node :glide ; val:port "out" ] ;
    val:to   [ val:node :r5 ; val:port "a" ] .

:a_r5_out__saw5_frequency a val:ControlArc ;
    val:from [ val:node :r5 ; val:port "out" ] ;
    val:to   [ val:node :saw5 ; val:port "frequency" ] .

:a_saw1_out__l1_in a val:Arc ;
    val:from [ val:node :saw1 ; val:port "out" ] ;
    val:to   [ val:node :l1 ; val:port "in" ] .

:a_l1_out__mix_in a val:Arc ;
    val:from [ val:node :l1 ; val:port "out" ] ;
    val:to   [ val:node :mix ; val:port "in" ] .

:a_saw2_out__l2_in a val:Arc ;
    val:from [ val:node :saw2 ; val:port "out" ] ;
    val:to   [ val:node :l2 ; val:port "in" ] .

:a_l2_out__mix_in a val:Arc ;
    val:from [ val:node :l2 ; val:port "out" ] ;
    val:to   [ val:node :mix ; val:port "in" ] .

:a_saw3_out__l3_in a val:Arc ;
    val:from [ val:node :saw3 ; val:port "out" ] ;
    val:to   [ val:node :l3 ; val:port "in" ] .

:a_l3_out__mix_in a val:Arc ;
    val:from [ val:node :l3 ; val:port "out" ] ;
    val:to   [ val:node :mix ; val:port "in" ] .

:a_saw4_out__l4_in a val:Arc ;
    val:from [ val:node :saw4 ; val:port "out" ] ;
    val:to   [ val:node :l4 ; val:port "in" ] .

:a_l4_out__mix_in a val:Arc ;
    val:from [ val:node :l4 ; val:port "out" ] ;
    val:to   [ val:node :mix ; val:port "in" ] .

:a_saw5_out__l5_in a val:Arc ;
    val:from [ val:node :saw5 ; val:port "out" ] ;
    val:to   [ val:node :l5 ; val:port "in" ] .

:a_l5_out__mix_in a val:Arc ;
    val:from [ val:node :l5 ; val:port "out" ] ;
    val:to   [ val:node :mix ; val:port "in" ] .

:a_filtEnv_out__cutoff_in a val:ControlArc ;
    val:from [ val:node :filtEnv ; val:port "out" ] ;
    val:to   [ val:node :cutoff ; val:port "in" ] .

:a_cutoff_out__vcf_cutoff a val:ControlArc ;
    val:from [ val:node :cutoff ; val:port "out" ] ;
    val:to   [ val:node :vcf ; val:port "cutoff" ] .

:a_mix_out__vcf_in a val:Arc ;
    val:from [ val:node :mix ; val:port "out" ] ;
    val:to   [ val:node :vcf ; val:port "in" ] .

:a_vcf_out__vca_in a val:Arc ;
    val:from [ val:node :vcf ; val:port "out" ] ;
    val:to   [ val:node :vca ; val:port "in" ] .

:a_ampEnv_out__vca_cv a val:ControlArc ;
    val:from [ val:node :ampEnv ; val:port "out" ] ;
    val:to   [ val:node :vca ; val:port "cv" ] .

:a_vca_out__chorus_in a val:Arc ;
    val:from [ val:node :vca ; val:port "out" ] ;
    val:to   [ val:node :chorus ; val:port "in" ] .

:a_chorus_out__trim_in a val:Arc ;
    val:from [ val:node :chorus ; val:port "out" ] ;
    val:to   [ val:node :trim ; val:port "in" ] .

:a_trim_out__limit_in a val:Arc ;
    val:from [ val:node :trim ; val:port "out" ] ;
    val:to   [ val:node :limit ; val:port "in" ] .

:a_limit_out__out_in a val:Arc ;
    val:from [ val:node :limit ; val:port "out" ] ;
    val:to   [ val:node :out ; val:port "in" ] .
