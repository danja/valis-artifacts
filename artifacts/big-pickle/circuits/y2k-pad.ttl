# circuits/y2k-pad.ttl
#
# A wide pad: eight voices of three saws, the sharp copy leaving on the left and the flat copy on the
# right, each side then through a soft low-pass, a high-pass, two choruses, a phaser and a room, with a
# slow attack and a long release. Based on the string-machine voice in circuits/quadra-strings.ttl, with
# a slower envelope, a darker tone and a longer room. The stereo split is what makes the pad wide.

@prefix val:   <http://purl.org/stuff/valis/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix trn:   <http://purl.org/stuff/transmissions/> .
@prefix :      <urn:valis-artifacts:big-pickle:y2kpad#> .


:Voice a val:Subcircuit ;
    rdfs:label "Voice" ;

    lv2:port [ a lv2:OutputPort , lv2:AudioPort ;
               lv2:symbol "left" ; lv2:name "Left" ;
               val:node :vcaL ; val:port "out" ] ,

             [ a lv2:OutputPort , lv2:AudioPort ;
               lv2:symbol "right" ; lv2:name "Right" ;
               val:node :vcaR ; val:port "out" ] ,

             [ a lv2:InputPort , lv2:ControlPort ;
               lv2:symbol "attack" ; lv2:name "Attack" ;
               lv2:default 900.0 ; lv2:minimum 5 ; lv2:maximum 3000 ;
               lv2:portProperty lv2:logarithmic ;
               units:unit units:ms ;
               val:node :env ; val:port "attack" ] ,

             [ a lv2:InputPort , lv2:ControlPort ;
               lv2:symbol "release" ; lv2:name "Release" ;
               lv2:default 900.0 ; lv2:minimum 20 ; lv2:maximum 4000 ;
               lv2:portProperty lv2:logarithmic ;
               units:unit units:ms ;
               val:node :env ; val:port "release" ] ;

    val:element :pitch , :up , :down , :sawA , :sawB , :sawC , :sumL , :sumR , :env , :vcaL , :vcaR ;
    val:arc :a_pitch_out__sawA_frequency ,
        :a_pitch_out__up_a ,
        :a_up_out__sawB_frequency ,
        :a_pitch_out__down_a ,
        :a_down_out__sawC_frequency ,
        :a_sawA_out__sumL_in ,
        :a_sawB_out__sumL_in ,
        :a_sawA_out__sumR_in ,
        :a_sawC_out__sumR_in ,
        :a_sumL_out__vcaL_in ,
        :a_sumR_out__vcaR_in ,
        :a_env_out__vcaL_cv ,
        :a_env_out__vcaR_cv .

:pitch a val:MidiPitch .

:up a val:ControlMultiply ;
    val:b 1.0065 .

:down a val:ControlMultiply ;
    val:b 0.9935 .

:sawA a val:Oscillator ;
    val:shape 1 .

:sawB a val:Oscillator ;
    val:shape 1 .

:sawC a val:Oscillator ;
    val:shape 1 .

:sumL a val:Mixer .

:sumR a val:Mixer .

:env a val:Envelope ;
    val:attack 900.0 ;
    val:decay 600.0 ;
    val:sustain 1.0 ;
    val:release 900.0 .

:vcaL a val:VCA .

:vcaR a val:VCA .

:a_pitch_out__sawA_frequency a val:Arc ;
    val:from [ val:node :pitch ; val:port "out" ] ;
    val:to   [ val:node :sawA ; val:port "frequency" ] .

:a_pitch_out__up_a a val:Arc ;
    val:from [ val:node :pitch ; val:port "out" ] ;
    val:to   [ val:node :up ; val:port "a" ] .

:a_up_out__sawB_frequency a val:Arc ;
    val:from [ val:node :up ; val:port "out" ] ;
    val:to   [ val:node :sawB ; val:port "frequency" ] .

:a_pitch_out__down_a a val:Arc ;
    val:from [ val:node :pitch ; val:port "out" ] ;
    val:to   [ val:node :down ; val:port "a" ] .

:a_down_out__sawC_frequency a val:Arc ;
    val:from [ val:node :down ; val:port "out" ] ;
    val:to   [ val:node :sawC ; val:port "frequency" ] .

:a_sawA_out__sumL_in a val:Arc ;
    val:from [ val:node :sawA ; val:port "out" ] ;
    val:to   [ val:node :sumL ; val:port "in" ] .

:a_sawB_out__sumL_in a val:Arc ;
    val:from [ val:node :sawB ; val:port "out" ] ;
    val:to   [ val:node :sumL ; val:port "in" ] .

:a_sawA_out__sumR_in a val:Arc ;
    val:from [ val:node :sawA ; val:port "out" ] ;
    val:to   [ val:node :sumR ; val:port "in" ] .

:a_sawC_out__sumR_in a val:Arc ;
    val:from [ val:node :sawC ; val:port "out" ] ;
    val:to   [ val:node :sumR ; val:port "in" ] .

:a_sumL_out__vcaL_in a val:Arc ;
    val:from [ val:node :sumL ; val:port "out" ] ;
    val:to   [ val:node :vcaL ; val:port "in" ] .

:a_sumR_out__vcaR_in a val:Arc ;
    val:from [ val:node :sumR ; val:port "out" ] ;
    val:to   [ val:node :vcaR ; val:port "in" ] .

:a_env_out__vcaL_cv a val:Arc ;
    val:from [ val:node :env ; val:port "out" ] ;
    val:to   [ val:node :vcaL ; val:port "cv" ] .

:a_env_out__vcaR_cv a val:Arc ;
    val:from [ val:node :env ; val:port "out" ] ;
    val:to   [ val:node :vcaR ; val:port "cv" ] .

:y2kpad a val:Circuit , trn:PluginProfile ;
    trn:role trn:AudioInstrument ;
    trn:accepts trn:Midi ;
    trn:produces trn:Audio ;
    trn:genre "Pad", "Ensemble", "Techno" ;
    rdfs:label "Y2K pad" ;
    val:element :poly , :toneL , :toneR , :thinL , :thinR , :ens1L , :ens2L , :ens1R , :ens2R ,
        :swirlL , :swirlR , :roomL , :roomR , :trimL , :trimR , :limitL , :limitR , :out ;
    val:arc :a_poly_left__toneL_in ,
        :a_toneL_out__thinL_in ,
        :a_thinL_out__ens1L_in ,
        :a_ens1L_out__ens2L_in ,
        :a_ens2L_out__swirlL_in ,
        :a_swirlL_out__roomL_in ,
        :a_roomL_out__trimL_in ,
        :a_trimL_out__limitL_in ,
        :a_limitL_out__out_left ,
        :a_poly_right__toneR_in ,
        :a_toneR_out__thinR_in ,
        :a_thinR_out__ens1R_in ,
        :a_ens1R_out__ens2R_in ,
        :a_ens2R_out__swirlR_in ,
        :a_swirlR_out__roomR_in ,
        :a_roomR_out__trimR_in ,
        :a_trimR_out__limitR_in ,
        :a_limitR_out__out_right .

:poly a :Voice ; val:voices 8 .

:toneL a val:OnePole ; val:mode 0 ; val:cutoff 3000.0 .
:toneR a val:OnePole ; val:mode 0 ; val:cutoff 3000.0 .

:thinL a val:OnePole ; val:mode 1 ; val:cutoff 180.0 .
:thinR a val:OnePole ; val:mode 1 ; val:cutoff 180.0 .

:ens1L a val:Chorus ; val:rate 0.55 ; val:depth 3.0 ; val:mix 0.5 .
:ens2L a val:Chorus ; val:rate 0.83 ; val:depth 2.2 ; val:mix 0.5 .
:ens1R a val:Chorus ; val:rate 0.55 ; val:depth 3.0 ; val:mix 0.5 .
:ens2R a val:Chorus ; val:rate 0.83 ; val:depth 2.2 ; val:mix 0.5 .

:swirlL a val:Phaser ; val:rate 0.18 ; val:depth 0.7 ; val:feedback 0.25 ; val:mix 0.3 .
:swirlR a val:Phaser ; val:rate 0.18 ; val:depth 0.7 ; val:feedback 0.25 ; val:mix 0.3 .

:roomL a val:Reverb ; val:size 1.1 ; val:decay 2.2 ; val:damping 0.5 ; val:mix 0.35 .
:roomR a val:Reverb ; val:size 1.1 ; val:decay 2.2 ; val:damping 0.5 ; val:mix 0.35 .

:trimL a val:Gain ; val:gain -12.0 .
:trimR a val:Gain ; val:gain -12.0 .

:limitL a val:Limiter ; val:ceiling -1.0 .
:limitR a val:Limiter ; val:ceiling -1.0 .

:out a val:Output .

:a_poly_left__toneL_in a val:Arc ;
    val:from [ val:node :poly ; val:port "left" ] ;
    val:to   [ val:node :toneL ; val:port "in" ] .

:a_toneL_out__thinL_in a val:Arc ;
    val:from [ val:node :toneL ; val:port "out" ] ;
    val:to   [ val:node :thinL ; val:port "in" ] .

:a_thinL_out__ens1L_in a val:Arc ;
    val:from [ val:node :thinL ; val:port "out" ] ;
    val:to   [ val:node :ens1L ; val:port "in" ] .

:a_ens1L_out__ens2L_in a val:Arc ;
    val:from [ val:node :ens1L ; val:port "out" ] ;
    val:to   [ val:node :ens2L ; val:port "in" ] .

:a_ens2L_out__swirlL_in a val:Arc ;
    val:from [ val:node :ens2L ; val:port "out" ] ;
    val:to   [ val:node :swirlL ; val:port "in" ] .

:a_swirlL_out__roomL_in a val:Arc ;
    val:from [ val:node :swirlL ; val:port "out" ] ;
    val:to   [ val:node :roomL ; val:port "in" ] .

:a_roomL_out__trimL_in a val:Arc ;
    val:from [ val:node :roomL ; val:port "out" ] ;
    val:to   [ val:node :trimL ; val:port "in" ] .

:a_trimL_out__limitL_in a val:Arc ;
    val:from [ val:node :trimL ; val:port "out" ] ;
    val:to   [ val:node :limitL ; val:port "in" ] .

:a_limitL_out__out_left a val:Arc ;
    val:from [ val:node :limitL ; val:port "out" ] ;
    val:to   [ val:node :out ; val:port "left" ] .

:a_poly_right__toneR_in a val:Arc ;
    val:from [ val:node :poly ; val:port "right" ] ;
    val:to   [ val:node :toneR ; val:port "in" ] .

:a_toneR_out__thinR_in a val:Arc ;
    val:from [ val:node :toneR ; val:port "out" ] ;
    val:to   [ val:node :thinR ; val:port "in" ] .

:a_thinR_out__ens1R_in a val:Arc ;
    val:from [ val:node :thinR ; val:port "out" ] ;
    val:to   [ val:node :ens1R ; val:port "in" ] .

:a_ens1R_out__ens2R_in a val:Arc ;
    val:from [ val:node :ens1R ; val:port "out" ] ;
    val:to   [ val:node :ens2R ; val:port "in" ] .

:a_ens2R_out__swirlR_in a val:Arc ;
    val:from [ val:node :ens2R ; val:port "out" ] ;
    val:to   [ val:node :swirlR ; val:port "in" ] .

:a_swirlR_out__roomR_in a val:Arc ;
    val:from [ val:node :swirlR ; val:port "out" ] ;
    val:to   [ val:node :roomR ; val:port "in" ] .

:a_roomR_out__trimR_in a val:Arc ;
    val:from [ val:node :roomR ; val:port "out" ] ;
    val:to   [ val:node :trimR ; val:port "in" ] .

:a_trimR_out__limitR_in a val:Arc ;
    val:from [ val:node :trimR ; val:port "out" ] ;
    val:to   [ val:node :limitR ; val:port "in" ] .

:a_limitR_out__out_right a val:Arc ;
    val:from [ val:node :limitR ; val:port "out" ] ;
    val:to   [ val:node :out ; val:port "right" ] .

:p0 a val:Param ; val:slot 0 ;
    val:target :poly ; val:property val:attack ;
    lv2:name "Attack" ; lv2:symbol "attack" ;
    lv2:minimum 5 ; lv2:maximum 3000 ;
    val:section "Envelope" ;
    units:unit units:ms .
:p1 a val:Param ; val:slot 1 ;
    val:target :poly ; val:property val:release ;
    lv2:name "Release" ; lv2:symbol "release" ;
    lv2:minimum 20 ; lv2:maximum 4000 ;
    val:section "Envelope" ;
    units:unit units:ms .
:p2 a val:Param ; val:slot 2 ;
    val:target :toneL , :toneR ; val:property val:cutoff ;
    lv2:name "Brightness" ; lv2:symbol "brightness" ;
    lv2:minimum 600 ; lv2:maximum 12000 ;
    val:section "Tone" ;
    units:unit units:hertz .
